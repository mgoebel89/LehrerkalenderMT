# Update aus dem Lehrerbereich: Sicherung, lehrerkalender-update, danach erneut pruefen (als root).
[Unit]
Description=LehrerkalenderMT: Update ausfuehren
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lehrerkalender-selbstupdate ausfuehren
TimeoutStartSec=20min
