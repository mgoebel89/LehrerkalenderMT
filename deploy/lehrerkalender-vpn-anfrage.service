# VPN einrichten, pruefen oder ausschalten im Auftrag von Admin > System (als root, siehe deploy/vpn.sh "anfrage").
[Unit]
Description=Lehrerkalender MT: VPN-Auftrag ausfuehren
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lehrerkalender-vpn anfrage
TimeoutStartSec=5min
