# Einmal am Tag nach einer neuen Version suchen (installiert wird nur auf Knopfdruck).
[Unit]
Description=LehrerkalenderMT: taeglich nach neuer Version suchen

[Timer]
OnCalendar=*-*-* 06:00
RandomizedDelaySec=2h
Persistent=true
Unit=lehrerkalender-update-pruefen.service

[Install]
WantedBy=timers.target
