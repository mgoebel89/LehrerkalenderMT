# Lehrerkalender MT Webseite: https://<container> (Port 443); http (Port 80) leitet um und liefert /ca.crt.
[Unit]
Description=Lehrerkalender MT Webseite
After=network-online.target
Wants=network-online.target

[Service]
User=lehrerkalender
Group=lehrerkalender
WorkingDirectory=/opt/lehrerkalender
Environment=LEHRERKALENDER_DATEN=/var/lib/lehrerkalender
Environment=PYTHONUNBUFFERED=1
# Zertifikat vor jedem Start pruefen bzw. erneuern; "+" = als root, "-" = Fehler stoppt den Start nicht (dann HTTP)
ExecStartPre=-+/usr/local/sbin/lehrerkalender-tls
ExecStart=/usr/bin/python3 -m app.server
Restart=always
RestartSec=5
# Ports 80/443 ohne root, sonst kaum Rechte
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# neue Dateien (Datenbank) nur fuer den Dienst lesbar
UMask=0027
ProtectSystem=strict
ReadWritePaths=/var/lib/lehrerkalender
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
